# Copy to backend/.env for running the API outside Docker. Never commit a real .env.
DATABASE_URL=postgresql+psycopg://cic:cic@127.0.0.1:5432/cic
RABBITMQ_URL=amqp://cic:cic@127.0.0.1:5672/%2F
LOG_LEVEL=INFO
# AI provider: "fake" needs no key. For a real model set openai or azure_openai and a key.
LLM_PROVIDER=fake
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
